void NetworkModeSelectionActivity::onEnter() {
  Activity::onEnter();

  // Scan for Lua Plugins
  luaPlugins.clear();
  LOG_INF("PLUGINS", "Scanning root directory for plugins...");
  
  fs::File root = SD.open("/");
  if (root) {
      fs::File file = root.openNextFile();
      while (file) {
          String n = file.name();
          LOG_INF("PLUGINS", "Root item: %s", n.c_str());
          
          // Check if this item is "plugins" (case-insensitive)
          if (n.equalsIgnoreCase("plugins") || n.equalsIgnoreCase("/plugins")) {
              LOG_INF("PLUGINS", "Found plugins directory!");
              fs::File pDir = SD.open(n.c_str());
              if (pDir && pDir.isDirectory()) {
                  fs::File entry = pDir.openNextFile();
                  while (entry) {
                      String eName = entry.name();
                      LOG_INF("PLUGINS", "Checking plugin: %s", eName.c_str());
                      
                      // Construct path to main.lua
                      String mainPath = String(n) + "/" + eName + "/main.lua";
                      if (SD.exists(mainPath.c_str())) {
                          luaPlugins.push_back(eName.c_str());
                          LOG_INF("PLUGINS", "Added: %s", eName.c_str());
                      }
                      entry = pDir.openNextFile();
                  }
                  pDir.close();
              }
          }
          file = root.openNextFile();
      }
      root.close();
  } else {
      LOG_ERR("PLUGINS", "Failed to open SD root!");
  }

  // Reset selection
  selectedIndex = 0;
  skipNextButtonCheck = true;
  requestUpdate();
}
